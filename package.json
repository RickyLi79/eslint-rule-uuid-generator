{
  "name": "@rickyli79/eslint-rule-uuid-generator",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "version": "0.1.0",
  "description": "ESLint rule that replaces configurable placeholder string literals (e.g. '\\UUID') with fresh v4/v7 UUIDs via autofix.",
  "license": "MIT",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintrule",
    "uuid",
    "uuid-v7",
    "autofix"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "pnpm run build",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": " ^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "uuid": "^14.0.1"
  }
}
